# ── Приложение ──────────────────────────────────────────────────────
PROJECT_NAME=softForMarket

# ── Сервер ──────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=80
USE_HTTPS=false
SSL_CHAIN_PATH=
SSL_KEY_PATH=

# ── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=softformarket
POSTGRES_SCHEMA=marketplace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# ── Безопасность ────────────────────────────────────────────────────
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=[]

# ── Публичный домен (ссылки клиентам + редиректы) ───────────────────
BASE_PUBLIC_URL=https://example.com

# ── Telegram (уведомления в группу) ─────────────────────────────────
TG_BOT_TOKEN=change-me
TG_CHAT_ID=-100123456789
TG_PROXY_ENABLED=false
TG_PROXY_URL=proxy1.example.com:1080,proxy2.example.com:1080

# ── GGSEL ───────────────────────────────────────────────────────────
GGSEL_SELLER_ID=123456
GGSEL_API_KEY=change-me

# ── Digiseller / PLATI ──────────────────────────────────────────────
DIGI_SELLER_ID=123456
DIGI_API_KEY=change-me

# ── Поставщик SMM Panel (боевой: через него идут все новые заказы) ───
SMM_PANEL_BASE_URL=https://panel.example.com
SMM_PANEL_API_KEY=change-me

# ── Поставщик Fragment (Telegram Stars и Premium) ────────────────────
FRAGMENT_BASE_URL=https://fragment.example.com
FRAGMENT_API_KEY=change-me

# ── Поставщик TeaTeaGram (legacy: только статусы старых заказов) ─────
TEA_API_KEY=change-me

# ── Поведение ───────────────────────────────────────────────────────
AUTO_MARK_DELIVERED=false
# TTL блокировки от повторной обработки заказа, сек.
INFLIGHT_TTL_SECONDS=600
# Задержка перед фоновой проверкой статуса у поставщика, сек.
STATUS_CHECK_DELAY_SECONDS=60

# ── Поллер чатов GGSEL (worker-процесс) ─────────────────────────────
# Интервал опроса, сек.
GGSEL_CHAT_POLL_INTERVAL=15
# При первой встрече чата: true — проглотить историю, false — переслать её в TG.
GGSEL_CHAT_BOOTSTRAP_SILENT=false
# Сколько страниц списка чатов опрашивать за цикл.
GGSEL_CHAT_MAX_PAGES=10
# Тянуть сообщения только из чатов, где last_message не старше N дней.
GGSEL_CHAT_FRESH_DAYS=1

# ── Поллер статусов заказов (worker-процесс) ────────────────────────
# Интервал опроса незавершённых заказов, сек.
ORDER_POLL_INTERVAL=60
# Сколько заказов проверять за цикл.
ORDER_POLL_BATCH=200
# Перестаём опрашивать заказ старше N часов.
ORDER_POLL_MAX_AGE_HOURS=48

# Интервал проверки очереди, сек.
OUTBOX_POLL_INTERVAL=1
# Максимум сообщений за одну итерацию.
OUTBOX_BATCH_SIZE=50
# Максимум одновременных HTTP-запросов и арендованных сообщений.
OUTBOX_MAX_CONCURRENCY=10
# Время аренды сообщения одним worker, сек. Должно превышать полный HTTP timeout с ретраями.
OUTBOX_LEASE_SECONDS=180
# Сколько ждать завершения уже начатого batch при штатной остановке worker.
OUTBOX_SHUTDOWN_GRACE_SECONDS=30
# Начальная и максимальная задержка повторов, сек.
OUTBOX_BACKOFF_BASE=2
OUTBOX_BACKOFF_MAX=300
# Период очистки и срок хранения доставленных сообщений.
OUTBOX_CLEANUP_INTERVAL=3600
OUTBOX_CLEANUP_RETENTION_DAYS=3
