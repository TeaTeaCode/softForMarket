# ── Приложение ──────────────────────────────────────────────────────
PROJECT_NAME=softForMarket

# ── Сервер ──────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=80
USE_HTTPS=false
SSL_CHAIN_PATH=
SSL_KEY_PATH=

# ── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_HOST=65.21.210.87
POSTGRES_PORT=5432
POSTGRES_DB=qwerty
POSTGRES_SCHEMA=qwerty
POSTGRES_USER=postgres
POSTGRES_PASSWORD=qwerty

# ── Безопасность ────────────────────────────────────────────────────
SECRET_KEY="qwerty"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# ── Логирование ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ── Публичный домен (ссылки клиентам + редиректы) ───────────────────
BASE_PUBLIC_URL=https://example.com

# ── Telegram (уведомления в группу) ─────────────────────────────────
TG_BOT_TOKEN=qwerty
TG_CHAT_ID=-123
TG_CHAT_ID_DIGISELLER=-123
TG_PROXY_ENABLED=true
TG_PROXY_URL=socks5://qwerty

# ── GGSEL ───────────────────────────────────────────────────────────
GGSEL_SELLER_ID=123
GGSEL_API_KEY=qwerty

# ── Digiseller / PLATI ──────────────────────────────────────────────
DIGI_SELLER_ID=123
DIGI_API_KEY=123

# ── Поставщик TeaTeaGram ────────────────────────────────────────────
TEA_API_KEY=qwerty

# ── Поведение ───────────────────────────────────────────────────────
AUTO_MARK_DELIVERED=false
INFLIGHT_TTL_SECONDS=600
GGSEL_CHAT_POLL_INTERVAL=15
STATUS_CHECK_DELAY_SECONDS=60
GGSEL_CHAT_BOOTSTRAP_SILENT=false
GGSEL_CHAT_MAX_PAGES=10
GGSEL_CHAT_FRESH_DAYS=1